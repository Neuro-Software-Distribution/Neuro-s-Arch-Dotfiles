#!/usr/bin/env bash

# FIX FOR THE AWWW ISSUES
## waits for the wayland socket, then starts awww daemon b4 setting the image
set -u
. "$(dirname "$(readlink -f "$0")")/runtime.sh"
exec 9>"$CYBER_RUNTIME/wallpaper.lock"
flock -w 30 9 || exit 1
wallpapers_path="${HOME}/Pictures/Wallpapers"
wallpaper_lua="${XDG_CONFIG_HOME:-${HOME}/.config}/cyberarch/wallpaper.lua"
wallpaper="${wallpapers_path}/netwatch/main.mp4"
if [ -r "$wallpaper_lua" ]; then
    lua_wallpaper="$(sed -n 's/^[[:space:]]*wallpaper[[:space:]]*=[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$wallpaper_lua" | tail -n 1)"
    if [ -n "${lua_wallpaper:-}" ]; then
        wallpaper="$lua_wallpaper"
    fi
fi
if [ "$#" -ge 1 ] && [ -n "${1:-}" ]; then
    wallpaper="$1"
fi
if [ ! -r "$wallpaper" ]; then
    wallpaper="${HOME}/.config/hypr/themes/cyberpunk/assets/img/lucy_wallpaper.png"
fi

# Publish the greeter copy only after the desktop renderer accepts the image.
# Stage beside the destination so a failed copy never destroys the old file.
sync_greeter_wallpaper() {
    local sddm_current="${CYBER_SDDM_CURRENT_DIR:-/usr/share/sddm/themes/netwatch/current}"
    local ext kind stage destination old
    [ -d "$sddm_current" ] && [ -w "$sddm_current" ] && [ -r "$wallpaper" ] || return 0
    case "$wallpaper" in *.*) ext="$(printf '%s' "${wallpaper##*.}" | tr '[:upper:]' '[:lower:]')" ;; *) return 0 ;; esac
    case "$ext" in
        mp4|webm|mkv|mov) kind=video ;;
        png|jpg|jpeg|webp|gif) kind=image ;;
        *) return 0 ;;
    esac
    destination="$sddm_current/$kind.$ext"
    stage="$(mktemp "$sddm_current/.wallpaper.XXXXXX")" || return 1
    if ! cp -- "$wallpaper" "$stage" || ! chmod 644 "$stage" || ! mv -f -- "$stage" "$destination"; then
        rm -f -- "$stage"
        return 1
    fi
    for old in "$sddm_current"/image.* "$sddm_current"/video.*; do
        [ "$old" = "$destination" ] || rm -f -- "$old"
    done
}

cache_dir="${XDG_CACHE_HOME:-${HOME}/.cache}/awww"
mkdir -p "$cache_dir" "${HOME}/.cache"

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
find_compositor_socket() {
    if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "$runtime_dir/$WAYLAND_DISPLAY" ] && [[ "$WAYLAND_DISPLAY" =~ ^wayland-[0-9]+$ ]]; then
        return 0
    fi
    unset WAYLAND_DISPLAY
    for socket in "$runtime_dir"/wayland-[0-9]*; do
        [ -S "$socket" ] || continue
        candidate="${socket##*/}"
        [[ "$candidate" =~ ^wayland-[0-9]+$ ]] || continue
        if WAYLAND_DISPLAY="$candidate" wlr-randr >/dev/null 2>&1; then
            export WAYLAND_DISPLAY="$candidate"
            return 0
        fi
    done
    return 1
}

mpvpaper_ready() {
    local pid="$1" socket="$2"
    # A live process or an open IPC socket alone is not enough: mpv can stay
    # alive after decoder/output setup fails. Video parameters appear only once
    # mpv has accepted a video stream for rendering.
    command -v socat >/dev/null 2>&1 || return 1
    for _ in $(seq 1 200); do
        if [ -S "$socket" ] \
           && printf '%s\n' '{ "command": ["get_property", "video-params"] }' \
              | timeout 1 socat - "UNIX-CONNECT:$socket" 2>/dev/null \
              | grep -Eq '"error"[[:space:]]*:[[:space:]]*"success"'; then
            return 0
        fi
        kill -0 "$pid" 2>/dev/null || return 1
        sleep 0.05
    done
    return 1
}

# Do not stop renderers belonging to another Wayland session of the same user.
# A process whose environment cannot be inspected is left alone.
session_pids() {
    local pid
    while IFS= read -r pid; do
        [ -n "$pid" ] || continue
        if tr '\0' '\n' 2>/dev/null < "/proc/$pid/environ" | grep -Fxq -- "WAYLAND_DISPLAY=$WAYLAND_DISPLAY"; then
            printf '%s\n' "$pid"
        fi
    done < <(pgrep -u "$(id -u)" -x "$1" 2>/dev/null || true)
}

compositor_ready=0
if command -v wlr-randr >/dev/null 2>&1; then
    for _ in $(seq 1 200); do
        if find_compositor_socket && wlr-randr >/dev/null 2>&1; then
            compositor_ready=1
            break
        fi
        sleep 0.05
    done
else
    for _ in $(seq 1 100); do
        if find_compositor_socket; then
            compositor_ready=1
            break
        fi
        sleep 0.05
    done
fi

if [ "$compositor_ready" -ne 1 ]; then
    printf '%s\n' 'Wayland compositor did not become ready' >>"${HOME}/.cache/cyberpunk-awww.log"
    exit 1
fi

wp_ext="$(printf '%s' "${wallpaper##*.}" | tr '[:upper:]' '[:lower:]')"
case "$wp_ext" in
    mp4|webm|mkv|mov)
        if command -v mpvpaper >/dev/null 2>&1; then
            old_mpvp="$(session_pids mpvpaper)"
            old_awww="$(session_pids awww-daemon)"
            # Hyprland instance signatures can make CYBER_RUNTIME exceed the
            # Unix socket path limit. Use a short, private temporary directory.
            socket_dir="$(mktemp -d "$runtime_dir/cw.XXXXXXXX")" || exit 1
            sock="$socket_dir/mpv.sock"
            mpvpaper -o "no-audio --really-quiet --loop-file=inf --keepaspect=no --hwdec=auto-safe --gpu-shader-cache=no --input-ipc-server=$sock" ALL "$wallpaper" 9>&- >>"${HOME}/.cache/cyberpunk-mpvpaper.log" 2>&1 &
            new_pid=$!
            if mpvpaper_ready "$new_pid" "$sock"; then
                rm -f "$sock"
                rmdir "$socket_dir" 2>/dev/null || true
                [ -n "$old_mpvp" ] && kill $old_mpvp 2>/dev/null
                [ -n "$old_awww" ] && kill $old_awww 2>/dev/null
                sync_greeter_wallpaper || printf '%s\n' 'Could not update the greeter wallpaper' >>"${HOME}/.cache/cyberpunk-awww.log"
                exit 0
            fi
            kill "$new_pid" 2>/dev/null || true
            wait "$new_pid" 2>/dev/null || true
            rm -f "$sock"
            rmdir "$socket_dir" 2>/dev/null || true
            printf '%s\n' 'new mpvpaper never became render-ready |::| keeping the previous wallpaper' >>"${HOME}/.cache/cyberpunk-mpvpaper.log"
            exit 1
        fi
        printf '%s\n' 'mpvpaper not found |::| falling back to the static wallpaper' >>"${HOME}/.cache/cyberpunk-awww.log"
        wallpaper="${HOME}/.config/hypr/themes/cyberpunk/assets/img/lucy_wallpaper.png"
        ;;
esac

for _ in $(seq 1 80); do
    if timeout 2 awww query >/dev/null 2>&1; then
        if timeout 5 awww img --transition-type none "$wallpaper" >>"${HOME}/.cache/cyberpunk-awww.log" 2>&1; then
            old_mpvp="$(session_pids mpvpaper)"
            [ -n "$old_mpvp" ] && kill $old_mpvp 2>/dev/null
            sync_greeter_wallpaper || printf '%s\n' 'Could not update the greeter wallpaper' >>"${HOME}/.cache/cyberpunk-awww.log"
            exit 0
        fi
        exit 1
    fi

    if [ -z "$(session_pids awww-daemon)" ]; then
        awww-daemon --no-cache 9>&- >>"${HOME}/.cache/cyberpunk-awww-daemon.log" 2>&1 &
    fi
    sleep 0.05
done

printf '%s\n' 'awww-daemon did not become ready' >>"${HOME}/.cache/cyberpunk-awww.log"
exit 1
