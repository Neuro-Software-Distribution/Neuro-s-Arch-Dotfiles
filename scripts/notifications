#!/usr/bin/env bash
# Opt-in native notification handoff. The shell popup remains the fallback.
set -euo pipefail
DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
. "$DIR/runtime.sh"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/cyberarch"
FLAG="$STATE/native-notifications-enabled"
DISABLED="$STATE/native-notifications-disabled"
PIDFILE="$CYBER_RUNTIME/notification-renderer.pid"
mkdir -p "$STATE"

has_name() {
    gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.NameHasOwner "$1" 2>/dev/null | grep -q true
}
server_info() {
    # Never auto-activate a server while inspecting the current owner.
    has_name org.freedesktop.Notifications || return 1
    timeout 2 busctl --user --auto-start=no call org.freedesktop.Notifications \
        /org/freedesktop/Notifications org.freedesktop.Notifications GetServerInformation 2>/dev/null
}
native_pid() {
    local pid exe
    [ -r "$PIDFILE" ] || return 1
    read -r pid < "$PIDFILE"
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    exe="$(readlink -f "/proc/$pid/exe" 2>/dev/null || true)"
    case "$exe" in "$CYBER_RUNTIME"/build.*/notification-renderer) printf '%s\n' "$pid" ;; *) return 1 ;; esac
}
start_native() {
    local info binary pid previous previous_exe owner_pid service_pid expected healthy
    exec 9>"$CYBER_RUNTIME/notifications.lock"
    flock -w 15 9 || { echo 'Notification handoff is busy.' >&2; return 1; }
    binary="$(readlink -f "$CYBER_RUNTIME/current/notification-renderer" 2>/dev/null || true)"
    [ -n "$binary" ] && [ -x "$binary" ] || { echo 'The native notification renderer was not built.' >&2; return 1; }
    if previous="$(native_pid)"; then
        previous_exe="$(readlink -f "/proc/$previous/exe" 2>/dev/null || true)"
        if [ "$previous_exe" = "$binary" ]; then
            # A live process alone is not enough: it may be reconnecting or hung.
            for _ in $(seq 1 160); do
                native_pid >/dev/null || break
                if has_name io.neuros.NotificationRenderer; then
                    owner_pid="$(busctl --user status io.neuros.NotificationRenderer 2>/dev/null | sed -n 's/^PID=//p' | head -n 1)"
                    [ "$owner_pid" != "$previous" ] || return 0
                fi
                sleep 0.05
            done
        fi
        kill "$previous" 2>/dev/null || true
        for _ in $(seq 1 100); do
            native_pid >/dev/null || break
            sleep 0.05
        done
        native_pid >/dev/null && { echo 'Previous notification renderer did not stop.' >&2; return 1; }
        rm -f "$PIDFILE"
        for _ in $(seq 1 100); do
            has_name io.neuros.NotificationRenderer || break
            sleep 0.05
        done
    fi
    if has_name io.neuros.NotificationRenderer; then
        echo 'A NeurOS notification renderer is already running in another session.' >&2
        return 1
    fi
    expected="$(readlink -f "$CYBER_RUNTIME/current" 2>/dev/null || true)"
    healthy="$(timeout 3 astal -i cyberpunk health 2>/dev/null || true)"
    [ -n "$expected" ] && [ "$healthy" = "$expected" ] || { echo 'The NeurOS shell is not ready.' >&2; return 1; }
    info="$(server_info || true)"
    case "$info" in
        'ssss "dunst" '*)
            systemctl --user is-active --quiet dunst.service || {
                echo 'Dunst is not managed by the user service; leaving it untouched.' >&2; return 1;
            }
            owner_pid="$(busctl --user status org.freedesktop.Notifications 2>/dev/null | sed -n 's/^PID=//p' | head -n 1)"
            service_pid="$(systemctl --user show dunst.service -p MainPID --value 2>/dev/null || true)"
            [ -n "$owner_pid" ] && [ "$owner_pid" = "$service_pid" ] || {
                echo 'The notification owner does not match the Dunst user service; leaving it untouched.' >&2; return 1;
            }
            timeout 10 systemctl --user stop dunst.service || { echo 'Could not stop Dunst.' >&2; return 1; }
            ;;
        'ssss "notifd" "astal" '*) ;;
        '') ;;
        *) echo 'Another notification server is active; leaving it untouched.' >&2; return 1 ;;
    esac
    # Astal's proxy must attach to Astal, not to Dunst. The running shell
    # normally owns the name after Dunst exits and remains a visual fallback.
    for _ in $(seq 1 100); do
        info="$(server_info || true)"
        case "$info" in 'ssss "notifd" "astal" '*) break ;; esac
        sleep 0.05
    done
    case "$info" in
        'ssss "notifd" "astal" '*) ;;
        *)
            echo 'Astal did not take over notifications; retaining the current server.' >&2
            if ! has_name org.freedesktop.Notifications; then systemctl --user start dunst.service || true; fi
            return 1
            ;;
    esac
    setsid "$binary" --listen 9>&- >>"$STATE/notification-renderer.log" 2>&1 </dev/null &
    pid=$!
    printf '%s\n' "$pid" > "$PIDFILE"
    for _ in $(seq 1 160); do
        if ! kill -0 "$pid" 2>/dev/null; then break; fi
        if has_name io.neuros.NotificationRenderer; then
            owner_pid="$(busctl --user status io.neuros.NotificationRenderer 2>/dev/null | sed -n 's/^PID=//p' | head -n 1)"
            [ "$owner_pid" != "$pid" ] || return 0
        fi
        sleep 0.05
    done
    kill "$pid" 2>/dev/null || true
    rm -f "$PIDFILE"
    echo 'Native notification renderer did not become ready; the shell popup remains available.' >&2
    return 1
}

case "${1:-}" in
    enable)
        # Adopt the new shell-side fallback before changing notification ownership.
        "$DIR/restart"
        start_native
        exec 8>"$STATE/.notification-setup.lock"
        flock -w 30 8 || exit 1
        touch "$FLAG"
        rm -f "$DISABLED"
        echo 'Native NeurOS notifications are enabled.'
        ;;
    resume)
        [ -f "$FLAG" ] && [ ! -f "$DISABLED" ] || exit 0
        start_native
        ;;
    disable)
        exec 9>"$CYBER_RUNTIME/notifications.lock"
        flock -w 15 9 || exit 1
        exec 8>"$STATE/.notification-setup.lock"
        flock -w 30 8 || exit 1
        touch "$DISABLED"
        rm -f "$FLAG"
        if pid="$(native_pid)"; then
            kill "$pid" 2>/dev/null || true
            for _ in $(seq 1 100); do
                native_pid >/dev/null || break
                sleep 0.05
            done
            if native_pid >/dev/null; then
                echo 'Native renderer did not stop; the disabled preference was saved.' >&2
                exit 1
            fi
        fi
        rm -f "$PIDFILE"
        echo 'Native popups disabled; the NeurOS shell popup is the active fallback.'
        ;;
    status)
        if [ -f "$DISABLED" ]; then echo 'Native notifications: disabled by preference'
        elif [ -f "$FLAG" ]; then echo 'Native notifications: selected'
        else echo 'Native notifications: not selected'
        fi
        if pid="$(native_pid)" && has_name io.neuros.NotificationRenderer; then
            owner_pid="$(busctl --user status io.neuros.NotificationRenderer 2>/dev/null | sed -n 's/^PID=//p' | head -n 1)"
            if [ "$owner_pid" = "$pid" ]; then echo "Renderer: ready (PID $pid)"; else echo 'Renderer: not ready in this session'; fi
        else
            echo 'Renderer: not ready in this session'
        fi
        info="$(server_info || true)"
        case "$info" in
            'ssss "dunst" '*) echo 'Notification server: Dunst' ;;
            'ssss "notifd" "astal" '*) echo 'Notification server: Astal' ;;
            '') echo 'Notification server: none detected' ;;
            *) echo 'Notification server: another service' ;;
        esac
        ;;
    *) echo 'usage: notifications {enable|disable|resume|status}' >&2; exit 2 ;;
esac
